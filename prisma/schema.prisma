// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  privyId         String         @unique
  walletAddress   String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  cart            Cart?  
  purchases       Purchase[]
  surveyResponses SurveyResponse[]
}

model NFT {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  price       Decimal  @db.Decimal(10, 2) // Using Decimal for precise currency math
  currency    Currency @default(USD)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  type        NFTType  @relation(fields: [typeId], references: [id])
  typeId      String

  PurchaseItem PurchaseItem[]
}

enum Currency {
  USD
  FORTO
  ETH
  SOL
}

model NFTType {
  id              String   @id @default(cuid())
  name            String   @unique
  nfts            NFT[]
}

model Cart {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id])
  userId          String @unique
  items           CartItem[]
  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())
}

model CartItem {
  id              String   @id @default(cuid())
  cart            Cart     @relation(fields: [cartId], references: [id])
  cartId          String
  nftId           String
  quantity        Int      @default(1)
  addedAt         DateTime @default(now())

  @@unique([cartId, nftId]) // Prevent duplicate items in cart
}

model Purchase {
  id              String         @id @default(cuid())
  user            User           @relation(fields: [userId], references: [id])
  userId          String
  items           PurchaseItem[]
  purchasedAt     DateTime       @default(now())
  txHash          String?        @unique // Ensure transaction hash is unique
  totalAmount     String          // Added for easier querying
}

model PurchaseItem {
  id              String     @id @default(cuid())
  purchase        Purchase   @relation(fields: [purchaseId], references: [id])
  purchaseId      String
  nft             NFT        @relation(fields: [nftId], references: [id])
  nftId           String
  quantity        Int        @default(1)
  priceAtPurchase Float
}

model SurveyQuestion {
  id              String     @id @default(cuid())
  question        String
  type            QuestionType  // Enforced enum type
  options         String[]      // For MCQ questions
  minSelections   Int           @default(1)
  maxSelections   Int           @default(1)
  maxLength       Int?          @default(500) // For text answers
  required        Boolean       @default(true)
  active          Boolean       @default(true)
  order           Int           // For question ordering
  createdAt       DateTime      @default(now())

  responses       SurveyResponse[]

  @@index([order]) // For efficient sorting
}

model SurveyResponse {
  id              String        @id @default(cuid())
  user            User          @relation(fields: [userId], references: [id])
  userId          String
  question        SurveyQuestion @relation(fields: [questionId], references: [id])
  questionId      String
  // Text response (for 'text' type questions)
  textAnswer      String?       @db.VarChar(2000) // Explicit length limit
  // MCQ response (for 'mcq' type questions)
  selectedOptions Int[]         @default([])      // Stores option indices
  metadata        Json?         // For any additional data (timing, etc)
  submittedAt     DateTime      @default(now())

  // Composite unique constraint - one response per user per question
  @@unique([userId, questionId])

  // Index for faster lookups
  @@index([userId])
  @@index([questionId])
}

enum QuestionType {
  MCQ
  TEXT
  RATING // Added for future extensibility
}